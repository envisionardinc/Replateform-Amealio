{
  "name": "Amealio Replatforming (multi-repo dev)",
  "install": "bash /agent/repos/Replateform-Amealio/.cursor/install.sh",
  "start": "bash /agent/repos/Replateform-Amealio/.cursor/start.sh",
  "terminals": [
    {
      "name": "nestjs-tracking-backend",
      "command": "cd /agent/repos/amealio-nestjs-backend && npm run start:dev"
    },
    {
      "name": "feathers-platform-backend",
      "command": "cd /agent/repos/Amealio-VendorDashboard && npm run dev"
    },
    {
      "name": "self-delivery-app",
      "command": "cd /agent/repos/amealio-self-delivery-app && PORT=3001 npm run dev"
    },
    {
      "name": "user-web-app",
      "command": "cd /agent/repos/amealio_web_app && PORT=3002 BROWSER=none CI=false npm run start-dev"
    }
  ],
  "ports": [3000, 3001, 3002, 5001]
}
