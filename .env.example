# Amealio target platform — LOCAL DEVELOPMENT configuration only.
# Copy to `.env` for local dev. NEVER commit real secrets. NEVER use production credentials.
#
# Environments are distinguished by which env file / DATABASE_URL you load:
#   development -> .env            (this template)
#   test        -> .env.test       (amealio_test database)
#   staging     -> managed by infra (NOT configured in this repo)
#   production  -> managed by infra (NOT configured in this repo)
#
# This repo (P1.5) configures development and test ONLY. Do not add production config here.

# ---- Development database (matches docker-compose.yml) ----
# Synthetic local credentials — safe to share for local dev.
DATABASE_URL="postgresql://amealio:amealio_dev_pw@localhost:5432/amealio_dev?schema=public"

# ---- Test database (used by the validation suite) ----
# Copy to .env.test, or export TEST_DATABASE_URL when running db:validate.
TEST_DATABASE_URL="postgresql://amealio:amealio_dev_pw@localhost:5432/amealio_test?schema=public"

# ---- Node environment ----
NODE_ENV=development

# ---- Consumer authentication (P1.7.1B) — DEVELOPMENT only ----
# Access-token signing secret. Dev-only value; a real secret is infra-managed in staging/prod.
JWT_ACCESS_SECRET="dev-only-access-secret-change-me"
JWT_ACCESS_TTL_SECONDS=900        # access token lifetime (seconds)
REFRESH_TTL_DAYS=30               # refresh session lifetime (days)
CONSUMER_AUTH_ENABLED=true        # feature flag for the new consumer auth endpoints (local/dev)

# ---- Staff/admin authentication (P1.7.1E) — DEVELOPMENT only ----
# Dedicated staff secret boundary (NOT the consumer secret). Dev-only value; a
# real secret is infra-managed in staging/prod.
STAFF_JWT_ACCESS_SECRET="dev-only-staff-access-secret-change-me"
STAFF_JWT_ACCESS_TTL_SECONDS=900  # staff access token lifetime (seconds)
STAFF_REFRESH_TTL_DAYS=30         # staff refresh session lifetime (days)
STAFF_AUTH_ENABLED=true           # feature flag for the new staff/admin auth endpoints (local/dev)
