{
  "name": "@amealio/api",
  "version": "0.0.0",
  "private": true,
  "description": "Amealio NestJS modular-monolith API (workspace app). Runtime/dev dependencies are hoisted from the monorepo root.",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest"
  }
}
