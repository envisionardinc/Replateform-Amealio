{
  "name": "amealio-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Amealio target platform — TurboRepo monorepo. Root orchestrates workspace tasks (apps/*) via Turbo and owns Prisma/PostgreSQL (P1.5). Business domains live inside apps/api (modular monolith).",
  "workspaces": [
    "apps/*"
  ],
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint && eslint \"prisma/**/*.ts\"",
    "format": "prettier --write \"apps/**/*.ts\" \"prisma/**/*.ts\"",
    "format:check": "prettier --check \"apps/**/*.ts\" \"prisma/**/*.ts\"",
    "start": "npm run start --workspace @amealio/api",
    "start:dev": "npm run start:dev --workspace @amealio/api",
    "start:prod": "npm run start:prod --workspace @amealio/api",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:validate": "npm run test --workspace @amealio/api -- test/schema.test.ts",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
