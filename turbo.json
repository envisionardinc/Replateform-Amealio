{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV", "PORT", "DATABASE_URL", "TEST_DATABASE_URL", "CORS_ORIGIN", "LOG_LEVEL"],
  "tasks": {
    "build": {
      "outputs": ["dist/**"]
    },
    "lint": {
      "outputs": []
    },
    "format:check": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
